<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- The paragon toast. Inherits Blizzard's alert frame so it queues behind
         loot and achievement toasts and honours the player's alert settings,
         rather than drawing itself wherever it likes.

         AlertFrameTemplate carries scripts and nothing else — no art, and no
         animation groups. AlertFrame_PlayIntroAnimation plays `animIn` and
         AlertFrame_PlayOutAnimation plays `waitAndAnimOut.animOut`, so a
         template that does not define both raises on the first toast shown and
         never dismisses itself afterwards. Every Blizzard alert template
         declares its own pair for that reason.

         Shape, timings and art follow CriteriaAlertFrameTemplate in
         Blizzard_FrameXML/Mainline/AlertFrameSystems.xml, which is the same
         thing this is: one line of text beside one icon, on the mini card. -->
    <ContainedAlertFrame name="BitForge_RepRankToastTemplate" parent="UIParent" hidden="true" inherits="AlertFrameTemplate" virtual="true">
        <Size x="256" y="84"/>
        <Anchors>
            <Anchor point="BOTTOM" x="0" y="0"/>
        </Anchors>
        <Animations>
            <AnimationGroup parentKey="animIn">
                <Alpha fromAlpha="1" toAlpha="0" duration="0" order="1"/>
                <Alpha fromAlpha="0" toAlpha="1" duration="0.2" order="2"/>
            </AnimationGroup>
            <AnimationGroup parentKey="waitAndAnimOut">
                <Alpha startDelay="4.05" fromAlpha="1" toAlpha="0" duration="1.5" parentKey="animOut">
                    <Scripts>
                        <OnFinished>
                            self:GetRegionParent():Hide();
                        </OnFinished>
                    </Scripts>
                </Alpha>
            </AnimationGroup>
        </Animations>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background" atlas="ui-achievement-alert-background-mini" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="LEFT" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <!-- The same marker the reputation pane puts on a faction
                     with a chest waiting, so the toast and the row read as one
                     indicator rather than two. -->
                <Texture parentKey="Icon" atlas="ParagonReputation_Bag">
                    <Size x="40" y="40"/>
                    <Anchors>
                        <Anchor point="LEFT" x="20" y="3"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </ContainedAlertFrame>
</Ui>
