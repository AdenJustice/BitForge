package-as: BitForge

# topdir stays the repository root for all six packages here -- a subfolder of a
# monorepo holds no .git of its own and release.sh rejects a topdir without one
# (release.sh:506-516) -- so each package is selected by its own .pkgmeta and
# reaches its own folder through the one move-folders entry below. Every ignore:
# and externals: path here is therefore repository-root-relative, not
# BitForge/-relative. The move-folders key is not: release.sh resolves it
# against $releasedir (release.sh:2686) while the tree is copied into
# $releasedir/<package-as>, so it reads <package-as>/<repository-root path>.
move-folders:
  BitForge/BitForge: BitForge

# LibDeflate has no CurseForge/wowace SVN mirror -- WeakAuras2, which also
# depends on it, externals the same GitHub URL. Pinned to the tag vendored
# below so a package rebuild can never silently diverge from what was tested.
#
# LibStub itself has no such mirror problem and no tagged releases either --
# it is versioned by an internal minor number that has barely moved in over a
# decade, not by SVN tags -- so this is the same svn://.../trunk external
# LibDeflate's own .pkgmeta uses for the identical dependency.
#
# Why ship a library nearly every other addon also ships: LibStub checks its
# own minor version before redefining itself (`if not LibStub or LibStub.minor
# < LIBSTUB_MINOR then ...`), so whichever copy another addon already loaded
# first wins and this one silently defers to it. Loading a second, third or
# tenth copy across a player's whole addon set is the normal, safe case this
# library is built for -- it is not a conflict risk the way two copies of an
# ordinary library would be.
#
# Provenance of the committed bytes, which this external does not itself
# record (it names where the *packager* fetches from at release time, not
# where BitForge/Libs/LibStub/LibStub.lua as checked in came from): the
# wowace SVN host above needs authenticated access this development machine
# doesn't have and svn itself isn't installed here, so the committed copy was
# fetched from the git-svn mirror github.com/WoWAddonMirrors/LibStub instead,
# cross-checked byte-identical against a second independent mirror,
# github.com/wowace-clone/LibStub. sha256 of the committed LibStub.lua:
# 7ba7300471327c0de1b3e42a4edfd62cbad79bd30100d6377736d2c1080e9b96.
#
# One consequence worth stating rather than re-deriving: the committed copies
# are not what ships. release.sh copies each external over the staged tree at
# release time, so LibDeflate's pinned `tag: 1.0.2-release` guarantees the
# shipped bytes equal the reviewed bytes -- but LibStub's `tag: latest` means
# the zip carries whatever wowace trunk holds at build time, which can differ
# from the committed copy above. That is universal practice for this library
# and not a defect; it is just otherwise invisible.
externals:
  BitForge/Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: 1.0.2-release
  BitForge/Libs/LibStub:
    url: svn://svn.wowace.com/wow/libstub/mainline/trunk
    tag: latest

enable-nolib-creation: no

ignore:
  # The five sibling modules and BitForge_Dev. Each module is packaged by its
  # own .pkgmeta now, and BitForge_Dev is a development-only tool that never
  # reaches a release; all six are absent from move-folders above AND listed
  # here, and only the second of those actually excludes them: move-folders
  # relocates the one folder it names rather than dropping the rest, so an
  # unlisted one stays inside the package root rather than being dropped. For BitForge_Dev neither is the real
  # guarantee -- Scripts/public_tree.sh keeps it off main, and the packager only
  # ever runs against the public repo -- but a second line of defence should be
  # one that works. Do not "fix" either omission.
  - BitForge_AutoBalance
  - BitForge_AzerothPrime
  - BitForge_Dev
  - BitForge_EUI
  - BitForge_RepRank
  - BitForge_TaskTome
  # Core's own diagnostics. Both halves of the exclusion are needed and each
  # fails silently alone -- tests/python/test_debug_directories.py holds them
  # together. The .toc line is wrapped in #@debug@ so the released .toc does
  # not name a file this list has dropped. Each module now excludes its own
  # debug/ from its own .pkgmeta instead of from here.
  - BitForge/debug
  - .claude
  - .github
  - .wow-api-audit
  - docs
  - Scripts
  - tests
  - .gitignore
  - .wowluarc.json
  - "*/.wowluarc.json"
  - CLAUDE.md

  # An external is a checkout of the library's whole repository, so it arrives
  # with everything that repository keeps beside the library. LibDeflate's is an
  # ldoc build -- seven .html files and a stylesheet under docs/ -- and
  # CurseForge refuses an archive carrying web content.
  #
  # It refuses it *after* the upload returns, out of band, saying only "General
  # error processing file", so the packager reports Success! and the release
  # workflow stays green: v12.1.0.8 and v12.1.0.9 both reached GitHub and
  # neither reached CurseForge. tests/python/test_pkgmeta_externals.py is what
  # catches this now, because nothing in the pipeline itself does.
  #
  # WeakAuras2 externals the same GitHub URL and strips docs, examples and *.md
  # the same way. LibDeflate's own .pkgmeta already drops tests/ and tools/, but
  # not docs/, which is generated output it commits.
  - BitForge/Libs/LibDeflate/docs
  - BitForge/Libs/LibDeflate/examples
  - BitForge/Libs/LibDeflate/tests
  - BitForge/Libs/LibDeflate/*.md
  - BitForge/Libs/LibDeflate/*.rockspec
  - BitForge/Libs/LibStub/docs
  - BitForge/Libs/LibStub/examples
  - BitForge/Libs/LibStub/tests
  - BitForge/Libs/LibStub/*.md

  # LibBitForgeUI is a git submodule, not an external -- its checkout is on
  # disk already, not fetched at package time -- but it carries its own test
  # suite and README the same way, and the packager has no externals-only
  # exemption from this list. docs and examples are empty today, but listed
  # ahead of need to match the LibDeflate/LibStub pattern above rather than
  # waiting for the day the library grows either.
  - BitForge/Libs/LibBitForgeUI/docs
  - BitForge/Libs/LibBitForgeUI/examples
  - BitForge/Libs/LibBitForgeUI/tests
  - BitForge/Libs/LibBitForgeUI/*.md

  # The library has since grown the same development apparatus this repository
  # keeps out of its own zip -- workflow skills, a packaging pipeline of its
  # own, a language server config. The root ignores above are anchored at the
  # package root and reach none of it, so each one is named again here.
  #
  # The library's own .pkgmeta is the one worth pausing over: it belongs to the
  # library's standalone release and has no authority over this package, so it
  # is ignored like any other development file rather than deferred to. A
  # nested .pkgmeta this list did not drop would ship as dead metadata inside
  # BitForge's zip.
  - BitForge/Libs/LibBitForgeUI/.claude
  - BitForge/Libs/LibBitForgeUI/.github
  - BitForge/Libs/LibBitForgeUI/.gitignore
  - BitForge/Libs/LibBitForgeUI/.pkgmeta
  - BitForge/Libs/LibBitForgeUI/.wowluarc.json
